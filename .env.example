# File cấu hình tùy chọn: mọi biến đều có giá trị mặc định trong docker-compose.yml.
# Muốn đổi thì sao chép thành .env rồi sửa:  cp .env.example .env
# Không commit file .env lên Git.

# PostgreSQL (dùng chung cho container database và backend)
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_secret

# Cổng PostgreSQL mở ra máy host (chỉ 127.0.0.1) để xem dữ liệu bằng DBeaver.
# Đổi thành 5433 nếu máy đã cài sẵn PostgreSQL chiếm cổng 5432.
DB_HOST_PORT=5432

# Số kết nối CSDL tối đa của MỖI bản sao backend (số bản sao x DB_POOL_MAX phải dưới 100)
DB_POOL_MAX=10

# Cổng truy cập website qua Nginx (đổi sang 8080 nếu cổng 80 bị chiếm)
NGINX_PORT=80

# Đăng nhập bằng Google (để trống thì nút Google báo chưa cấu hình). Cách lấy:
# Google Cloud Console > Google Auth Platform > Clients > Create client > Web application
# > Authorized JavaScript origins: http://localhost (thêm :8080 nếu đổi NGINX_PORT) và https://<tên miền>
GOOGLE_CLIENT_ID=

# Quên mật khẩu: địa chỉ website ghi trong email đặt lại mật khẩu (đổi thành https://<tên miền> khi chạy tên miền)
APP_URL=http://localhost

# Máy chủ gửi email (SMTP). Để trống SMTP_HOST thì email không gửi đi mà in ra log:  docker compose logs backend
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<mật khẩu ứng dụng 16 ký tự>
# (tạo tại myaccount.google.com > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Người gửi hiển thị, mặc định "AuraMall <SMTP_USER>"
MAIL_FROM=
# Thay cho SMTP: gửi qua HTTPS API của Brevo (bắt buộc khi chạy trên Render gói Free vì cổng SMTP bị chặn).
# MAIL_FROM khi đó phải là email người gửi đã xác minh trên Brevo.
BREVO_API_KEY=
# Hoặc gửi bằng chính hộp thư Gmail qua Gmail API (HTTPS, chạy được trên Render gói Free; ưu tiên hơn Brevo/SMTP).
# Tạo đủ 3 biến + MAIL_FROM bằng:  node scripts/gmail-auth.js <file client_secret_xxx.json>  (xem README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Đưa web ra Internet bằng tên miền qua Cloudflare Tunnel (để trống nếu chỉ chạy localhost).
# Cloudflare > Networking > Tunnels > Create Tunnel > Docker > copy token; Routes > Published application
# trỏ tên miền tới http://nginx:80. Chạy: docker compose --profile tunnel up -d  (xem README)
CLOUDFLARE_TUNNEL_TOKEN=

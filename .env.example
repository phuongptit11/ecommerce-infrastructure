# File cấu hình tùy chọn: mọi biến đều có giá trị mặc định trong docker-compose.yml.
# Muốn đổi thì sao chép thành .env rồi sửa:  cp .env.example .env
# Không commit file .env lên Git.

# PostgreSQL (dùng chung cho container database và backend)
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_secret

# Cổng PostgreSQL mở ra máy host (chỉ 127.0.0.1) để xem dữ liệu bằng DBeaver.
# Đổi thành 5433 nếu máy đã cài sẵn PostgreSQL chiếm cổng 5432.
DB_HOST_PORT=5432

# Số kết nối CSDL tối đa của MỖI bản sao backend (số bản sao x DB_POOL_MAX phải dưới 100)
DB_POOL_MAX=10

# Cổng truy cập website qua Nginx (đổi sang 8080 nếu cổng 80 bị chiếm)
NGINX_PORT=80
